function forceRefreshDriverAirportAuth(){var t0=Date.now(),refreshed=0,skippedNoAuth=0,failed=0;var profiles=callSupabase('user_profiles?role=eq.driver&source=eq.ssot_driver_airport&select=id,staff_id&limit=5000')||[],auth={};profiles.forEach(function(p){if(p.staff_id)auth[p.staff_id]=p.id});var targets=[],seen={};var ss=getDriverAirportSpreadsheet_();DRIVER_AIRPORT_TABS.forEach(function(tab){var sh=ss.getSheetByName(tab);if(!sh)return;sh.getDataRange().getValues().slice(1).forEach(function(row){var id=_drvNormId_(row[1]);if(!/^\d{6,}$/.test(id)||seen[id])return;seen[id]=true;if(!auth[id]){skippedNoAuth++;return}targets.push({driverId:id,authId:auth[id]})})});for(var i=0;i<targets.length;i+=50){var b=targets.slice(i,i+50),resp=UrlFetchApp.fetchAll(b.map(function(t){return {url:CONFIG.SUPABASE_URL+'/auth/v1/admin/users/'+t.authId,method:'put',contentType:'application/json',headers:{apikey:CONFIG.SUPABASE_KEY,Authorization:'Bearer '+CONFIG.SUPABASE_KEY},payload:JSON.stringify({password:t.driverId}),muteHttpExceptions:true}}));resp.forEach(function(r,j){if(r.getResponseCode()>=200&&r.getResponseCode()<300)refreshed++;else{failed++;try{logSistem('error','forceRefreshDriverAirportAuth','error',b[j].driverId+' HTTP '+r.getResponseCode())}catch(_){}}})}var elapsed=((Date.now()-t0)/1000).toFixed(1);logSistem('recovery','forceRefreshDriverAirportAuth',failed?'warning':'success','refreshed='+refreshed+' skipped='+skippedNoAuth+' failed='+failed+' '+elapsed+'s');return {refreshed:refreshed,skippedNoAuth:skippedNoAuth,failed:failed,errors:failed,elapsed_s:Number(elapsed)}}
